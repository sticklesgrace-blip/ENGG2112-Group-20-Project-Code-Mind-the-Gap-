def fetch_trip_data(origin_name, destination_name):

    api_key = os.getenv("TFNSW_API_KEY")

    if not api_key:
        st.error("TFNSW_API_KEY not found.")
        return pd.DataFrame()

    origin_id = str(station_ids[origin_name])
    destination_id = str(station_ids[destination_name])

    url = "https://api.transport.nsw.gov.au/v1/tp/trip"
    headers = {"Authorization": f"apikey {api_key}"}

    today = datetime.now()

    selected_datetime = datetime.combine(
        today.date(),
        arrival_time)

    params = {
        "outputFormat": "rapidJSON",
        "type_origin": "any",
        "name_origin": origin_id,
        "type_destination": "any",
        "name_destination": destination_id,
        "coordOutputFormat": "EPSG:4326",
        "TfNSWTR": "true",
        "depArrMacro": "dep",
        "itdDate": selected_datetime.strftime("%Y%m%d"),
        "itdTime": selected_datetime.strftime("%H%M"),
    }

    response = requests.get(
        url,
        headers=headers,
        params=params,
        timeout=30
    )

    if response.status_code != 200:
        st.error(f"API request failed with status {response.status_code}")
        st.text(response.text[:500])
        return pd.DataFrame()

    data = response.json()
    rows = []

    query_time = selected_datetime.strftime(
    "%Y-%m-%d %H:%M:%S")

    for journey_i, journey in enumerate(data.get("journeys", []), start=1):

        for leg_i, leg in enumerate(journey.get("legs", []), start=1):

            transport = leg.get("transportation", {})
            origin = leg.get("origin", {})
            destination = leg.get("destination", {})

            for stop_i, stop in enumerate(leg.get("stopSequence", []), start=1):

                rows.append({
                    "query_time": query_time,
                    "query_origin": origin_name,
                    "query_destination": destination_name,

                    "journey_id": journey_i,
                    "leg_id": leg_i,
                    "stop_sequence": stop_i,

                    "line_name": transport.get("disassembledName"),
                    "route_number": transport.get("number"),

                    "origin_stop": origin.get("name"),
                    "destination_stop": destination.get("name"),
                    "stop_name": stop.get("name"),

                    "platform": (
                        stop.get("properties", {}).get("platform")
                        if isinstance(stop.get("properties"), dict)
                        else None
                    ),

                    "departure_time_estimated": stop.get("departureTimeEstimated"),
                    "departure_time_planned": stop.get("departureTimePlanned"),
                    "arrival_time_estimated": stop.get("arrivalTimeEstimated"),
                    "arrival_time_planned": stop.get("arrivalTimePlanned"),
                })

    return pd.DataFrame(rows)


# =====================================================
# Data Transformation
# =====================================================
def transform_trip_data(df_new):

    if df_new.empty:
        return pd.DataFrame()

    df_new = df_new.copy()

    time_cols = [
        "departure_time_planned",
        "departure_time_estimated",
        "arrival_time_planned",
        "arrival_time_estimated"
    ]

    for col in time_cols:
        df_new[col] = pd.to_datetime(df_new[col], errors="coerce")

    df_new["trip_key"] = (
        df_new["query_destination"].astype(str)
        + "_"
        + df_new["journey_id"].astype(str)
        + "_"
        + df_new["leg_id"].astype(str)
    )

    first_departure = (
        df_new.groupby("trip_key")["departure_time_planned"]
        .transform("first")
    )

    df_new["duration"] = (
        (df_new["arrival_time_planned"] - first_departure)
        .dt.total_seconds() / 60
    )

    origin_rows = df_new[df_new["stop_sequence"] == 1].copy()

    origin_rows["Platform_number"] = origin_rows["platform"].apply(
        extract_platform_number
    )

    origin_rows["departure_local"] = to_sydney(
        origin_rows["departure_time_planned"]
    )

    origin_rows["Date_of_departure"] = origin_rows["departure_local"].dt.date

    origin_rows["Time_of_departure"] = (
        origin_rows["departure_local"]
        .dt.strftime("%H%M")
        .astype(int)
    )

    origin_rows["Start_station"] = origin_rows["query_origin"]

    origin_meta = origin_rows[
        [
            "trip_key",
            "Start_station",
            "Date_of_departure",
            "Time_of_departure",
            "Platform_number",
            "departure_time_planned",
            "departure_time_estimated",
        ]
    ].set_index("trip_key")

    target_rows = (
        df_new.sort_values("stop_sequence")
        .groupby("trip_key")
        .last()
        .reset_index()
    )

    target_rows["Target_station"] = target_rows["query_destination"]
    target_rows["duration_to_target_min"] = target_rows["duration"]

    target_meta = target_rows[
        [
            "trip_key",
            "Target_station",
            "duration_to_target_min",
        ]
    ].set_index("trip_key")

    first_rail_leg = (
        df_new[df_new["line_name"].str.startswith("T", na=False)]
        .sort_values(["trip_key", "stop_sequence"])
        .groupby("trip_key")["line_name"]
        .first()
        .rename("Train_line")
    )

    origin_meta["Delay_time (minutes)"] = (
        (
            to_sydney(origin_meta["departure_time_estimated"])
            - to_sydney(origin_meta["departure_time_planned"])
        )
        .dt.total_seconds() / 60
    )

    df_data = (
        origin_meta
        .join(target_meta, how="left")
        .join(first_rail_leg, how="left")
        .reset_index(drop=True)
    )

    df_data["Delay_time (minutes)"] = df_data[
        "Delay_time (minutes)"
    ].fillna(0)

    df_data = df_data.dropna(subset=["Train_line"])

    return df_data

