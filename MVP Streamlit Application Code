    "Chatswood": PLATFORM_DIR / "Chatswood Platform Distances.csv",
}


@st.cache_data
def load_platform_data():
    dfs = {}

    for station, file in platform_files.items():
        temp = pd.read_csv(file)

        first_col = temp.columns[0]
        temp = temp.rename(columns={first_col: "Entrance"})

        dfs[station] = temp

    return dfs


platform_dfs = load_platform_data()


def get_platform_distance(station, entrance_code, platform_number):

    try:
        platform_number = int(platform_number)

        if station == "Chatswood" and platform_number in [2, 3]:
            return np.nan

        if station == "Lidcombe" and platform_number == 0:
            return np.nan

        df = platform_dfs[station]

        row = df[
            df["Entrance"]
            .astype(str)
            .str.contains(entrance_code, case=False, na=False)
        ]

        if row.empty:
            return np.nan

        possible_cols = [
            f"P{platform_number}",
            str(platform_number)
        ]

        for col in df.columns:
            if str(col).startswith(str(platform_number)):
                possible_cols.append(col)

        for col in possible_cols:
            if col in df.columns:
                return pd.to_numeric(row[col], errors="coerce").iloc[0]

        return np.nan

    except:
        return np.nan


