def extract_platform_number(platform_raw):

    if pd.isna(platform_raw):
        return None

    match = re.search(r"(\d+)$", str(platform_raw))

    return int(match.group(1)) if match else None


def hhmm_to_minutes(hhmm):

    hhmm = int(hhmm)

    hour = hhmm // 100
    minute = hhmm % 100

    return hour * 60 + minute


def time_to_peak_distance(hhmm):

    time_min = hhmm_to_minutes(hhmm)

    peak_times = [
        8*60,
        9*60,
        17*60,
        18*60
    ]

    return min(
        abs(time_min-p)
        for p in peak_times
    )


def to_sydney(series):

    try:
        return series.dt.tz_convert(SYDNEY_TZ)

    except TypeError:

        return (
            series
            .dt
            .tz_localize("UTC")
            .dt
            .tz_convert(SYDNEY_TZ)
        )

