def find_closest_departures(df, user_time_str, time_window_minutes, start_station, target_station):
    """
    Filters the DataFrame based on Start/Target stations and a 2-hour time window.
    """
    # Step 1: Filter by Start_station and Target_station
    # Using the exact casing from your provided image
    df_filtered = df[
        (df['Start_station'] == start_station) &
        (df['Target_station'] == target_station)
    ].copy()

    if df_filtered.empty:
        print(f"No departures found from {start_station} to {target_station}.")
        return df_filtered

    # Step 2: Time Filtering Logic
    # Convert user's time string to datetime for comparison
    user_time_dt = datetime.datetime.strptime(user_time_str, "%H%M")
    target_end_dt = user_time_dt + datetime.timedelta(minutes=time_window_minutes)

    # Convert the 'Time_of_departure' column to datetime objects
    # We use .apply to handle the string comparison logic
    df_filtered['departure_dt'] = df_filtered['Time_of_departure'].apply(
        lambda x: datetime.datetime.strptime(x, "%H%M")
    )

    # Handle midnight wrap-around:
    # If departure time is '0005' but user time is '2350', move departure to 'next day'
    df_filtered['adjusted_dt'] = df_filtered['departure_dt'].apply(
        lambda x: x if x >= user_time_dt else x + datetime.timedelta(days=1)
    )

    # Step 3: Apply the time window filter
    final_df = df_filtered[
        (df_filtered['adjusted_dt'] >= user_time_dt) &
        (df_filtered['adjusted_dt'] < target_end_dt)
    ].copy()

    # Sort by the actual chronological time
    final_df = final_df.sort_values(by='adjusted_dt').reset_index(drop=True)

    # Remove the temporary datetime columns used for calculation
    final_df = final_df.drop(columns=['departure_dt', 'adjusted_dt'])

    return final_df

