def calculate_sss_score(row, user_ndd):
    cluster_1 = ['asd', 'tourettes', 'chronic tic disorders', 'sensory processing disorder']
    cluster_2 = ['stutter', 'speech sound disorder']
    cluster_3 = ['adhd', 'dyslexia', 'learning disorder']
    cluster_4 = ['dcd', 'down syndrome', 'intellectual disorder']

    pop_density_score = row['Pop_density_score']
    departure_time_score = row['Departure_time_score']
    platform_scaled_distance = row['Platform_scaled_distance']
    delay_time_score = row['Delay_time_score']

    if user_ndd in cluster_1:
        return 0.35 * pop_density_score + 0.25 * departure_time_score + 0.3 * platform_scaled_distance + 0.1 * delay_time_score
    elif user_ndd in cluster_2:
        return 0.3 * pop_density_score + 0.2 * departure_time_score + 0.3 * platform_scaled_distance + 0.1 * delay_time_score
    elif user_ndd in cluster_3:
        return 0.1 * pop_density_score + 0.2 * departure_time_score + 0.3 * platform_scaled_distance + 0.1 * delay_time_score
    elif user_ndd in cluster_4:
        return 0.15 * pop_density_score + 0.1 * departure_time_score + 0.3 * platform_scaled_distance + 0.1 * delay_time_score
    else:
        return np.nan # Or some default score if NDD not found in any cluster

