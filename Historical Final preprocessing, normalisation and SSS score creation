def calculate_time_score(time_str):
  """
  Calculates a time score (1-5) based on closeness to peak hours.
  """
  time_int = int(time_str)

  # Assign scores based on time ranges: 6am-10am peak and 3-7pm peak
  if 730 <= time_int < 830 or 1630 <= time_int < 1730:
    return 5 # peak hour
  elif 700 <= time_int < 730 or 830 <= time_int < 900 or 1600 <= time_int < 1630 or 1730 <= time_int < 1800:
    return 4 # shoulder peak
  elif 630 <= time_int < 700 or 900 <= time_int < 930 or 1530 <= time_int < 1600 or 1800 <= time_int < 1830:
    return 3
  elif 600 <= time_int < 630 or 930 <= time_int < 1000 or 1500 <= time_int < 1530 or 1830 <= time_int < 1900:
    return 2
  else:
    return 1 # off-peak

