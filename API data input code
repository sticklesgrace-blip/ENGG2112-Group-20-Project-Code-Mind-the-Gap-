            if col.startswith('P') and pd.api.types.is_numeric_dtype(df[col]):
                platform_mean = df[col].mean()
                platform_std = df[col].std()
                platform_range = get_scaled_range(platform_mean, data_min_for_scaling, data_max_for_scaling, scale_min, scale_max)
                results.append({
                    'DataFrame': df_name,
                    'Platform': col,
