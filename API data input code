                "error":        response.text[:300],
            })
            continue

        data = response.json()
        rows = extract_rows(data, station_name, station_id)
        all_rows.extend(rows)
        # print(f"  ✓ {len(rows)} rows")
        time.sleep(0.5)

    except Exception as e:
        # print(f"  ✗ Exception: {e}")
        failed_stations.append({
            "query_time":   query_time,
            "station_name": station_name,
            "station_id":   station_id,
            "status":       "exception",
            "error":        str(e),
        })


# ───────── Dataframe Build ────────────────────────────────
df_new = pd.DataFrame(all_rows)

if df_new.empty:
    print("No data collected — check your API key and network connection.")
else:
    for col in ["departure_time_planned", "departure_time_estimated",
                "arrival_time_planned",   "arrival_time_estimated"]:
        df_new[col] = pd.to_datetime(df_new[col], errors="coerce")

    # Unique identifier per trip leg
    df_new["trip_key"] = (
        df_new["query_destination"].astype(str) + "_" +
        df_new["journey_id"].astype(str)         + "_" +
        df_new["leg_id"].astype(str)
    )

    # First planned departure per trip (= departure from origin station)
    first_dep_planned   = df_new.groupby("trip_key")["departure_time_planned"].transform("first")
    first_dep_estimated = df_new.groupby("trip_key")["departure_time_estimated"].transform("first")

    # Duration from origin to each intermediate stop
    df_new["duration"] = (
        (df_new["arrival_time_planned"] - first_dep_planned)
        .dt.total_seconds() / 60
    )
    df_new["duration"] = (
        (df_new["arrival_time_estimated"] - first_dep_estimated)
        .dt.total_seconds() / 60
    )
    # Prefer estimated; fall back to planned
    df_new["duration"] = (
        df_new["duration"]
        .fillna(df_new["duration"])
    )

# ===========================================
# Data Sorting and formatting
# ===========================================

# ── Helper (AI help) ────────────────────────────────────────────────────────────────────
def extract_platform_number(platform_raw):
    """Convert a raw platform code like 'CE16' → integer 16."""
    if pd.isna(platform_raw):
        return None
    match = re.search(r'(\d+)$', str(platform_raw))
    return int(match.group(1)) if match else None

SYDNEY_TZ = "Australia/Sydney"

def to_sydney(series: pd.Series) -> pd.Series:
    """Convert a UTC-aware datetime Series to Sydney local time."""
    try:
        return series.dt.tz_convert(SYDNEY_TZ)
    except TypeError:
        return series.dt.tz_localize("UTC").dt.tz_convert(SYDNEY_TZ)

# ── Origin metadata (one row per trip, at stop_sequence == 1) ────────────────────────────────────────────────────────────────────
origin_rows = df_new[df_new["stop_sequence"] == 1].copy()

origin_rows["platform_number"]    = origin_rows["platform"].apply(extract_platform_number)
origin_rows["departure_local"]    = to_sydney(origin_rows["departure_time_planned"])
origin_rows["Date_of_departure"]  = origin_rows["departure_local"].dt.date
origin_rows["Time_of_departure"]  = (
    origin_rows["departure_local"].dt.strftime("%H%M").astype(int)
)
origin_rows["Start_station"] = origin_rows["query_origin"]   # plain name stored earlier

origin_meta = origin_rows[[
    "trip_key", "Start_station", "Date_of_departure",
    "Time_of_departure", "platform_number",
    "departure_time_planned", "departure_time_estimated",
]].set_index("trip_key")

# ── Target stop metadata (last stop in each sequence) ────────────────────────────────────────────────────────────────────
target_rows = (
    df_new
    .sort_values("stop_sequence")
    .groupby("trip_key")
    .last()
    .reset_index()
)

target_rows["Target_station"]        = target_rows["query_destination"]
target_rows["duration_to_target_min"] = target_rows["duration"]

target_meta = target_rows[[
    "trip_key", "Target_station", "duration_to_target_min",
]].set_index("trip_key")

# ── Train Line ────────────────────────────────────────────────────────────────────
first_rail_leg = (
    df_new[df_new["line_name"].str.startswith("T", na=False)]
    .sort_values(["trip_key", "stop_sequence"])
    .groupby("trip_key")["line_name"]
    .first()
    .rename("Train_line")
)

# ── Delay Calculation ────────────────────────────────────────────────────────────────────

origin_meta["Delay_time (minutes)"] = (
    (to_sydney(origin_meta["departure_time_estimated"])
     - to_sydney(origin_meta["departure_time_planned"]))
    .dt.total_seconds() / 60
)

df_transformed = (
    origin_meta
    .join(target_meta,    how="left")
    .join(first_rail_leg, how="left")
    .reset_index(drop=True)
)

# ── Population density placeholder (unknown for moment) ────────────────────────────────────────────────────────────────────
df_transformed["Pop_density"] = "Unknown"

# Rename platform column to match historical schema
df_transformed.rename(columns={"platform_number": "Platform_number"}, inplace=True)

# ── Enforce column order and dtypes ────────────────────────────────────────────────────────────────────
HISTORICAL_COLUMNS = [
    "Start_station",
    "Target_station",
    "Train_line",
    "Pop_density",
    "Date_of_departure",
    "Time_of_departure",          # integer HHMM, e.g. 956 for 09:56
    "Delay_time (minutes)",       # float; NaN where estimated time unavailable
    "Platform_number",            # integer; Central departure platform
    "duration_to_target_min",     # float; planned travel time in minutes
]

cols_present        = [c for c in HISTORICAL_COLUMNS if c in df_transformed.columns]
df_data = df_transformed[cols_present].copy()

df_data["Time_of_departure"] = (
    pd.to_numeric(df_data["Time_of_departure"], errors="coerce")
    .astype("Int64")
)
df_data["Platform_number"] = (
    pd.to_numeric(df_data["Platform_number"], errors="coerce")
    .astype("Int64")
)

print("Transformed dataset shape:", df_data.shape)
display(df_data.head(10))

# ===========================================
# Data Clense and filtering
# ===========================================
df = df_data.dropna(subset = ['Train_line']).copy()        # remove columns with a NaN train line or platform number as we cannot use this data

df ['Delay_time (minutes)'] = df ['Delay_time (minutes)'].fillna(0)   # change NaN values to 0 for all delay times

# remove unnecessary platforms
reference_df = globals()[f'{random_starting_station}_df'] # call the correct platform data for this set
valid_platforms = [int(p[1:]) for p in reference_df.columns]  # ['P1','P2'...] → [1, 2...]
df = df[df['Platform_number'].isin(valid_platforms)]

# sort out non-relevant platforms
df = df[df['Target_station'] == input_data['Target Station']]
df = df[df['duration_to_target_min'].notna()]

display(df.head())
file_name = f'TFNSW_filtered_data_{timestamp_for_file}.csv'
df.to_csv(file_name, index = False)
