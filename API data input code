    global_mean = all_p_series.mean()
    global_std = all_p_series.std()
    print(f"Global Mean of 'P' values: {global_mean:.2f}")
    print(f"Global Standard Deviation of 'P' values: {global_std:.2f}")

    # 3. Define Scaling Parameters
    # We'll define the scaling range based on +/- 2 standard deviations from the global mean
    # Values outside this range will be capped at 1 or 5.
    data_min_for_scaling = max(0, global_mean - 2 * global_std) # Ensure min is not negative
    data_max_for_scaling = global_mean + 2 * global_std
    scale_min = 1
    scale_max = 5

    print(f"Scaling data range: [{data_min_for_scaling:.2f}, {data_max_for_scaling:.2f}]")

    # 4. Create Scaling Function
    def get_scaled_range(value, data_min, data_max, scale_min, scale_max):
        if data_max == data_min:
            return (scale_min + scale_max) / 2 # Handle cases with no variance

        # Cap value to the original data range for scaling
        capped_value = max(data_min, min(value, data_max))

        # Linear scaling to target range
        scaled_value = scale_min + ((capped_value - data_min) / (data_max - data_min)) * (scale_max - scale_min)
        return round(scaled_value)

    # 5. Process Each Platform/Column and 6. Store the results
    results = []
    for df_name, df in all_dfs_list:
