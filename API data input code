# ───────── API row extraction ────────────────────────────────
def extract_rows(data, destination_name, destination_id):
    rows = []

    for journey_i, journey in enumerate(data.get("journeys", []), start=1):
        legs = journey.get("legs", [])
        if not legs:
            continue

        for leg_i, leg in enumerate(legs, start=1):
            transport   = leg.get("transportation", {})
            origin      = leg.get("origin", {})
            destination = leg.get("destination", {})

            for stop_i, stop in enumerate(leg.get("stopSequence", []), start=1):
                coord = stop.get("coord")
                lat, lon = None, None
                if isinstance(coord, list) and len(coord) >= 2:
                    lon, lat = coord[0], coord[1]
                elif isinstance(coord, dict):
                    lat = coord.get("lat")
                    lon = coord.get("lon")

                rows.append({
                    "query_time":          query_time,
                    "query_origin":        ORIGIN_NAME,
                    "query_origin_id":     ORIGIN_ID,
                    "query_destination":   destination_name,
                    "query_destination_id": destination_id,
                    "destination_lines":   ", ".join(STATION_LINES.get(destination_name, [])),

                    "journey_id":     journey_i,
                    "leg_id":         leg_i,
                    "stop_sequence":  stop_i,

                    "line_name":      transport.get("disassembledName"),
                    "route_number":   transport.get("number"),

                    "origin_stop":      origin.get("name"),
                    "destination_stop": destination.get("name"),
                    "stop_name":        stop.get("name"),

                    "platform": (
                        stop.get("properties", {}).get("platform")
                        if isinstance(stop.get("properties"), dict) else None
                    ),

                    "departure_time_estimated": stop.get("departureTimeEstimated"),
                    "departure_time_planned":   stop.get("departureTimePlanned"),
                    "arrival_time_estimated":   stop.get("arrivalTimeEstimated"),
                    "arrival_time_planned":     stop.get("arrivalTimePlanned"),

                    "latitude":  lat,
                    "longitude": lon,
                })

    return rows

